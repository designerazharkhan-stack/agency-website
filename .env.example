# ---------------------------------------------------------------------------
# AGENCY WEBSITE — Frontend environment
#
# Copy to `.env.local` (git-ignored) and fill in with the values from your
# Firebase console: Project settings → Your apps → Web app → SDK setup.
#
#   VITE_ variables are inlined into the public JS bundle at build time.
#   NEVER place private keys, service-account JSON, admin SDK credentials or
#   any other secret in this file. All values here are considered public.
#   Admin write access is enforced by Firestore Security Rules, not by secrets.
# ---------------------------------------------------------------------------

# --- Firebase Web App config (public SDK config) ---------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only needed if you use Firebase Analytics / messaging.
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Local development -----------------------------------------------------
# Set to "true" to connect to the local Firebase emulators instead of prod.
VITE_USE_FIREBASE_EMULATORS=false

# --- Site / business details ---------------------------------------------
# Canonical production URL, used for SEO tags, sitemap and share links.
VITE_SITE_URL=https://agency-website.web.app
# Public fallback contact values shown when the CMS has none configured yet.
VITE_CONTACT_EMAIL=hello@agencywebsite.com
VITE_CONTACT_PHONE=+1 (415) 555-0182

# --- Feature flags ---------------------------------------------------------
# Set to "false" to remove /admin from the production bundle entirely.
VITE_ENABLE_ADMIN=true

